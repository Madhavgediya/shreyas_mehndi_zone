# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# MONGODB CONNECTION
# Example local MongoDB: mongodb://127.0.0.1:27017/shreyas_mehndi_zone
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shreyas_mehndi_zone?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shreyas_mehndi_zone

# JWT AUTHENTICATION
JWT_SECRET=super_secret_mehndi_zone_jwt_token_key_2026_secure
