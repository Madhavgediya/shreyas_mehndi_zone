# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secrets (Keep .env.example tracked)
# ==========================================
.env
.env.*
!.env.example
*.env
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# ==========================================
# Production Builds & Distribution
# ==========================================
dist/
dist-ssr/
build/
client/dist/
out/

# ==========================================
# User Uploads & Media Files
# ==========================================
uploads/
server/uploads/
!uploads/.gitkeep
!server/uploads/.gitkeep

# ==========================================
# Logs & Debug Output
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Runtime, Caches & Temporary Files
# ==========================================
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp
.cache/
.eslintcache

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# IDE & Code Editor Files
# ==========================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
